generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  email           String     @unique
  password        String?
  createdAt       DateTime   @default(now())
  name            String?
  resetCode       String?
  resetCodeExpiry DateTime?
  id              Int        @id @default(autoincrement())
  provider        String     @default("credentials")
  role            String     @default("USER")
  carts           Cart[]
  favorites       Favorite[]
  kyc             KYC?
  products        Product[]
  orders          Order[]
  searchLogs      SearchLog[]
  productViews    ProductView[]
}

model KYC {
  id              Int             @id @default(autoincrement())
  userId          Int             @unique
  fullName        String
  fatherName      String?
  documentType    KycDocumentType
  documentNumber  String
  documentExpiry  DateTime?
  documentFront   String
  documentBack    String
  faceImage       String
  status          KycStatus       @default(PENDING)
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomeSlider {
  id        Int      @id @default(autoincrement())
  images    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoBanner {
  id         Int      @id @default(autoincrement())
  title      String
  subtitle   String?
  buttonText String?  @default("Shop now")
  link       String?  @default("/")
  image      String?
  bgColor    String?  @default("#9a8478")
  size       String   @default("normal") // "large" | "normal"
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  image     String?
  link      String?  @default("/")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model SaleBanner {
  id         Int      @id @default(autoincrement())
  image      String?
  heading    String
  subheading String?
  buttonText String?  @default("Shop now")
  link       String?  @default("/")
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}

model InspirationImage {
  id        Int      @id @default(autoincrement())
  image     String
  link      String?  @default("/")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String?
  image     String?
  link      String?  @default("/")
  author    String?  @default("Admin")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  quote     String
  author    String
  brand     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model FeaturedProduct {
  id        Int      @id @default(autoincrement())
  image     String?
  title     String
  price     String?
  brand     String?
  link      String?  @default("/")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Product {
  id            String           @id @default(uuid())
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  imageUrls     String[]         @default([])
  isPublished   Boolean          @default(false)
  isFeatured    Boolean          @default(false)
  name          String
  price         Float
  brands        String[]         @default([])
  categories    String[]         @default([])
  colors        String[]         @default([])
  sizes         String[]         @default([])
  subCategories String[]         @default([])
  saleType      SaleType         @default(SELL)
  condition     ProductCondition @default(NEW)
  productTypes  String[]         @default([])
  userId        Int?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  carts         Cart[]
  favorites     Favorite[]
  orderItems    OrderItem[]
  views         ProductView[]

  @@index([price])
  @@index([userId])
}

model Order {
  id              String      @id @default(uuid())
  userId          Int
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          OrderStatus @default(PENDING)
  paymentMethod   String      @default("card")
  totalAmount     Float
  fullName        String
  email           String
  address         String
  city            String
  country         String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  price     Float
  quantity  Int     @default(1)
  size      String?
  imageUrl  String?

  @@index([orderId])
}

model SearchLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  query     String
  resultCount Int    @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model ProductView {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId String
  quantity  Int      @default(1)
  size      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, size])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  CNIC
  PASSPORT
  DRIVING_LICENSE
}

enum SaleType {
  RENT
  SELL
}

enum ProductCondition {
  NEW
  OLD
}
